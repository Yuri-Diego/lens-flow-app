# Copie para .env e preencha. O .env real nunca vai para o repositório.

# Porta HTTP da API (padrão 5000)
PORT=5000

# MongoDB. Precisa ser replica set (transações): Atlas em produção, ou
# mongod local com --replSet. A API conecta em DATABASE_URL, no banco
# DATABASE_NAME. Sem replica set a API sobe (fora de produção), mas cadastros
# e alterações falham. Ao subir, a API sincroniza os índices com os models.
DATABASE_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=lens-flow-dev

# Segredo para assinar a sessão (JWT). Obrigatório; em produção, pelo menos
# 32 caracteres. Gere um valor longo e aleatório, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio

# Origens do site, separadas por vírgula. Valem para o CORS e para a checagem
# de origem das requisições que alteram dados (POST, PATCH, DELETE).
CORS_ORIGINS=http://localhost:5173

# development | test | production. Em production o cookie da sessão é Secure
# e a API não sobe sem replica set.
NODE_ENV=development

# Opcional. Atrás de proxy reverso, o número de saltos até o cliente (ex.: 1),
# para o limite de tentativas de login ver o IP real. Sem proxy, deixe vazio.
TRUST_PROXY=

# Opcional. Custo do bcrypt (padrão 12; em produção, no mínimo 10).
BCRYPT_ROUNDS=

# Primeiro admin: npm run seed:admin lê SEED_ADMIN_PASSWORD (obrigatória) e,
# opcionalmente, SEED_ADMIN_USERNAME, SEED_ADMIN_NAME e SEED_BUSINESS_NAME.
# Passe-as só na linha de comando, sem gravar a senha aqui. Leia a senha sem
# eco, como no README (veja docs/api/CONTRATO.md, seção 6).

# Dados de demonstração: npm run seed:demo só roda num banco vazio. Passe outro
# banco no próprio comando, sem mudar este arquivo. Exemplo (bash):
#   DATABASE_NAME=lens-flow-demo npm run seed:demo
# Opcionais: SEED_DEMO_PROFILE (base, alto, estresse), SEED_DEMO_PER_DAY,
# SEED_DEMO_DAYS, SEED_DEMO_OPEN, SEED_DEMO_NOT_RELEASED, SEED_DEMO_PASSWORD,
# SEED_DEMO_MEASURE (false para não medir), SEED_DEMO_SAMPLES e SEED_DEMO_SEED.
