# Copie para .env e preencha. O .env real nunca vai para o repositório.

# Porta HTTP da API (padrão 5000)
PORT=5000

# MongoDB. Precisa ser replica set (transações): Atlas em produção, ou
# mongod local com --replSet. A API conecta em DATABASE_URL/DATABASE_NAME.
DATABASE_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=lens-flow

# Segredo para assinar a sessão (JWT). Gere um valor longo e aleatório, por
# exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# development | test | production
NODE_ENV=development
